programa {
  funcao inicio() {
    real num1,num2,num3,soma,divisao
escreva ("escreva 3 numeros")
escreva ("\n")
leia (num1)
leia(num2)
leia(num3)
 soma = (num1 + num2 + num3)
 escreva ("a soma dos 3 numeros da:")
 escreva ("\n")
 escreva (soma)
 escreva ("\n")
 divisao = (soma/2 )
 escreva ("a divisao da soma da:")
 escreva ("\n")
escreva (divisao)

  }
}
